rules_version = '2';
// =====================================================================
//  에코PE 사이즈 설문 — Firestore 보안 규칙
//  Firebase 콘솔 → Firestore Database → 규칙 탭에 전체를 붙여넣고 [게시]
//  ★ 아래 '관리자이메일@gmail.com' 을 js/config.js 의 ADMIN_EMAILS 와 똑같이 바꾸세요.
//  ★ 설문 마감일(아래 timestamp.date)도 config.js 의 surveyEnd 다음 날로 맞추세요.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['관리자이메일@gmail.com'];
    }

    function validCustom(c) {
      return c == null
        || (c is map && c.keys().hasOnly(['w', 'h', 't', 'note'])
            && c.w is number && c.w >= 10 && c.w <= 400
            && c.h is number && c.h >= 10 && c.h <= 400
            && c.t is string && c.t.size() <= 10
            && c.note is string && c.note.size() <= 100);
    }

    // 쿠폰 신청: 문서 이름이 'p_휴대폰번호' 여야 함 → 같은 번호로 두 번 신청 불가 (덮어쓰기 금지)
    // 쿠폰 미신청: 문서 이름이 'r_' + 무작위 20자, 개인정보 칸은 비어 있어야 함
    function validCoupon(d, id) {
      return (d.coupon == true
              && d.name is string && d.name.size() >= 2 && d.name.size() <= 20
              && d.phone is string && d.phone.matches('^01[016789][0-9]{7,8}$')
              && d.channel is string && d.channel.size() <= 20
              && d.consent == true
              && id == 'p_' + d.phone)
          || (d.coupon == false
              && d.name == '' && d.phone == '' && d.channel == '' && d.consent == false
              && id.matches('^r_[A-Za-z0-9]{20}$'));
    }

    function validResp(d, id) {
      let keys = ['sizes', 'custom', 'uses', 'thick', 'qty', 'comment', 'coupon',
                  'name', 'phone', 'channel', 'consent', 'src', 'v', 'status', 'createdAt'];
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.sizes is list && d.sizes.size() <= 2
        && validCustom(d.custom)
        && (d.sizes.size() > 0 || d.custom != null)
        && d.uses is list && d.uses.size() >= 1 && d.uses.size() <= 10
        && d.thick in ['thin', 'thick', 'any']
        && d.qty in ['single', 'bundle', 'both']
        && d.comment is string && d.comment.size() <= 500
        && d.coupon is bool && validCoupon(d, id)
        && d.src is string && d.src.size() <= 20
        && d.v is string && d.v.size() <= 20
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    match /responses/{id} {
      // 누구나 '새로 쓰기'만 가능 (수정·삭제·읽기 불가), 마감일 이후에는 쓰기도 막힘
      allow create: if isAdmin()
        || (validResp(request.resource.data, id) && request.time < timestamp.date(2027, 1, 1));
      // 결과 보기·상태 변경·파기는 관리자만
      allow read, update, delete: if isAdmin();
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
